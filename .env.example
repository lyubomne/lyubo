# Neon variables below are written by `neon deploy` / `neon checkout` (neon env pull)
DATABASE_URL=example
DATABASE_URL_UNPOOLED=example
NEON_BRANCH=example
NEON_BRANCH_ID=example
NEON_FUNCTION_HOST_SUFFIX=example
NEON_REALTIME_URL=example
NEON_REALTIME_SECRET=example
